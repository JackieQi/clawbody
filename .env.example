# ClawBody Configuration
# Give your OpenClaw AI agent a physical robot body!

# ==============================================================================
# REQUIRED: OpenAI API Key
# ==============================================================================
# Get your key at: https://platform.openai.com/api-keys
# Requires Realtime API access
OPENAI_API_KEY=sk-your-openai-key

# ==============================================================================
# REQUIRED: OpenClaw Gateway
# ==============================================================================
# The URL where your OpenClaw gateway is running.
# When ClawBody runs ON the robot, this must be reachable over the network:
# use your gateway machine's LAN IP or mDNS name (e.g. http://my-macbook.local:18789),
# NOT localhost/127.0.0.1 (that would point at the robot itself).
# The gateway must also listen on the LAN: set gateway.bind to "lan" in
# ~/.openclaw/openclaw.json (default is loopback-only) and restart the gateway.
OPENCLAW_GATEWAY_URL=http://*************:18789

# Your OpenClaw gateway authentication token
# Find this in ~/.openclaw/openclaw.json under gateway.token
# Note: on first connection from the robot, the gateway will hold a pending
# device pairing request. Approve it once on the gateway machine with:
#   openclaw devices list && openclaw devices approve <request-id>
OPENCLAW_TOKEN=your-gateway-token

# Agent ID to use (default: main)
OPENCLAW_AGENT_ID=main

# Session key for conversation context - IMPORTANT!
# Use "main" (default) to share context with WhatsApp and other DM channels
# This allows the robot to be aware of all your conversations
OPENCLAW_SESSION_KEY=main

# ==============================================================================
# OPTIONAL: Voice Settings
# ==============================================================================
# OpenAI Realtime voice (alloy, echo, fable, onyx, nova, shimmer, cedar)
OPENAI_VOICE=cedar

# OpenAI model for Realtime API (GA models only; the beta/preview realtime
# models were retired when OpenAI shut down the Realtime Beta API)
OPENAI_MODEL=gpt-realtime-2.1-mini

# Speech-to-text model for the Realtime session's input transcription
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe-2025-12-15

# Vision model for camera image analysis (cloud image-to-text fallback)
OPENAI_VISION_MODEL=gpt-4o-mini

# Local on-device image-to-text model (used only when local vision is
# enabled with --local-vision / ENABLE_LOCAL_VISION=true)
# LOCAL_VISION_MODEL=HuggingFaceTB/SmolVLM2-256M-Video-Instruct

# ==============================================================================
# OPTIONAL: Features
# ==============================================================================
# Enable/disable features (true/false)
ENABLE_CAMERA=true
ENABLE_OPENCLAW_TOOLS=true

ENABLE_FACE_TRACKING=true
HEAD_TRACKER_TYPE=mediapipe # yolo

# Body-follow face tracking (wireless base): when your face drifts far
# enough to the side that the head alone can't keep it in view, the base
# rotates underneath so tracking continues. The base has a hard stop at
# ~+/-157° (not continuous); base +/-150° plus neck +/-50° still covers the
# full circle, and after losing the face the base joins the room scan,
# unwinding the long way around when the seam blocks the short way.
# The loop closes through the camera, which lags a few hundred ms, so the
# gains are deliberately unhurried -- a hot gain on a laggy loop hunts, and
# a hunting base rocks the whole robot.
#   CLAWBODY_BODY_FOLLOW: on (default) / off - base follows the tracked face
#   CLAWBODY_BODY_FOLLOW_START: head yaw in degrees that engages the base
#   CLAWBODY_BODY_FOLLOW_GAIN: base speed per unit of head yaw (1/s)
#   CLAWBODY_BODY_FOLLOW_MAX_SPEED: base speed cap in deg/s
#   CLAWBODY_BODY_SEARCH: on (default) / off - base joins scan after a loss
#   CLAWBODY_TRACK_MAX_SPEED: cap on gaze swing speed in deg/s (default 60)
#   CLAWBODY_TRACK_MAX_LIN_SPEED: same cap for head shift, in m/s
CLAWBODY_BODY_FOLLOW=on
CLAWBODY_BODY_FOLLOW_START=18
CLAWBODY_BODY_FOLLOW_GAIN=1.1
CLAWBODY_BODY_FOLLOW_MAX_SPEED=30
CLAWBODY_BODY_SEARCH=on

# Motion envelope. Everything the robot does leaves through one 100Hz
# set_target, and the daemon servos to whatever pose it is handed as fast
# as the motors allow -- so a *step* in that pose is a full-torque impulse
# that rocks the base and can tip the robot over. Every command is passed
# through a velocity- AND acceleration-limited follower before it is sent.
# These are a safety envelope: well-behaved motion never touches them.
# Lower them if the robot still shakes; raise them if it feels sluggish.
#   CLAWBODY_HEAD_MAX_SPEED / CLAWBODY_HEAD_MAX_ACCEL: deg/s, deg/s^2
#   CLAWBODY_HEAD_MAX_LIN_SPEED / CLAWBODY_HEAD_MAX_LIN_ACCEL: m/s, m/s^2
#   CLAWBODY_BODY_MAX_SPEED / CLAWBODY_BODY_MAX_ACCEL: base slew, deg/s(^2)
#   CLAWBODY_GESTURE_SCALE: 0.2-1.5 multiplier on nod/shake/bounce/sway
#     amplitude (nodding and disagreeing are the only quick movements;
#     turn this down to make even those smaller)
#   CLAWBODY_RESYNC_DEG: how far the measured head pose may drift from the
#     commanded one before the smoother re-seeds from the real pose. The
#     daemon ignores set_target while it plays a recorded emotion, so this
#     is what stops the head snapping when it hands control back.
CLAWBODY_HEAD_MAX_SPEED=140
CLAWBODY_HEAD_MAX_ACCEL=900
CLAWBODY_HEAD_MAX_LIN_SPEED=0.12
CLAWBODY_HEAD_MAX_LIN_ACCEL=0.9
CLAWBODY_BODY_MAX_SPEED=70
CLAWBODY_BODY_MAX_ACCEL=110
CLAWBODY_GESTURE_SCALE=1.0
CLAWBODY_RESYNC_DEG=20

# Automatic head gestures synced to speech:
#   natural (default) - turn-level gestures at response start + live
#                       keyword-triggered gestures while speaking
#   turn              - turn-level gestures only
#   off               - no automatic gestures
CLAWBODY_GESTURE_MODE=natural

# Echo defense: while the robot is speaking OR its base motor is slewing,
# mic frames quieter than this RMS (0..1 float scale) are dropped so the
# robot doesn't hear its own speaker/motors and answer phantom turns.
# Speak up to interrupt. Raise it if the robot still hears itself; lower
# it if it's hard to interrupt; 0 disables.
CLAWBODY_BARGE_IN_RMS=0.06

# Turn detection. The chassis mics hear servo/antenna transients as loud
# as real speech, so energy-based VAD spawns phantom turns (junk/foreign
# hallucinated transcripts, robot chatting to nobody). semantic mode
# (default) lets the model judge whether audio is actually speech.
#   CLAWBODY_VAD_MODE=semantic|server
#   CLAWBODY_VAD_EAGERNESS=low|medium|high|auto (semantic mode; low =
#     waits longest before treating audio as a finished user turn)
#   CLAWBODY_VAD_THRESHOLD / CLAWBODY_VAD_SILENCE_MS (server mode only)
CLAWBODY_VAD_MODE=semantic
CLAWBODY_VAD_EAGERNESS=low

# Always-on mic noise gate, so hum/servo whine can't become phantom turns.
# Gated frames are sent as digital silence, not withheld: withholding
# deletes that slice of time from the stream the server hears, splicing a
# sentence's loud fragments together with its pauses removed.
#
# A flat floor does not work -- speech averaged over a 63 ms frame spends
# most of its time far below its own peaks, so a floor high enough to
# reject chassis noise also rejects the voice. A floor of 0.02 measured
# here passed only ~11% of frames while the user was plainly talking, and
# turn detection never fired. Hence open/close/hold instead:
#   MIC_FLOOR_RMS         - a frame this loud opens the gate
#   MIC_GATE_CLOSE_RMS    - only frames below this let it start closing
#   MIC_GATE_HANGOVER_S   - how long it stays open after the last such frame
# If the robot can't hear you: lower MIC_FLOOR_RMS toward the "max" figure
# in the Mic stats lines while you speak. If it talks to itself: raise it
# above the "max" figure logged while the room is quiet. The stats line
# reports "% voiced" -- during speech that should read well above 50%.
CLAWBODY_MIC_FLOOR_RMS=0.025
CLAWBODY_MIC_GATE_CLOSE_RMS=0.008
CLAWBODY_MIC_GATE_HANGOVER_S=0.4
# Periodic "Mic stats" log lines for tuning; 0 silences them.
CLAWBODY_MIC_STATS_S=5

# Sound-source orientation: when you start speaking, the robot reads the
# mic array's Direction of Arrival and turns its head toward your voice.
#   CLAWBODY_DOA_MODE: on (default) / off
#   CLAWBODY_DOA_FLIP: set to 1 if the robot turns away from you
CLAWBODY_DOA_MODE=on
CLAWBODY_DOA_FLIP=0

# ---------------------------------------------------------------------------
# Voice input gate
#
# The mic gate above decides which *audio frames* reach the server. This
# section decides which *transcripts* get an answer, which is a different
# problem: the noise gate cannot tell your voice from a child's, and the
# transcriber will happily return confident text for speech it did not
# actually resolve (observed: English/Mandarin audio coming back as Korean,
# Croatian, Turkish and Cyrillic).
#
# With the gate on, the robot answers only when addressed by name -- or
# within a short follow-up window after being addressed -- and only in a
# language on the allowlist. Everything else is dropped silently.
#
# Set CLAWBODY_VOICE_GATE=false to restore the old answer-everything
# behaviour; each rule below can also be disabled individually.
# ---------------------------------------------------------------------------
CLAWBODY_VOICE_GATE=true

# Require the robot be addressed by name. false = answer any in-language
# speech (still filters other languages, acks and noise).
CLAWBODY_WAKE_WORD_REQUIRED=true
# Comma-separated. Includes the mistranscriptions the STT actually produces
# for "Kira", because it rarely returns the correct spelling.
CLAWBODY_WAKE_WORDS=kira,奇拉,基拉
# Seconds after an addressed turn during which follow-ups don't need the
# name again; each accepted turn refreshes it. 0 = name required every time.
CLAWBODY_WAKE_GRACE_S=30

# Language families that get an answer. Detected by Unicode script, which
# is exact, rather than by language ID, which is unreliable on a
# five-character voice turn. "ja" is deliberately absent: children in the
# room speak Japanese and their speech must not be treated as input.
CLAWBODY_VOICE_LANGUAGES=en,zh
# Latin transcripts with fewer letters than this are noise, not requests.
# This is the confabulation guard: a two-character fragment carries no
# instruction, and handing one to the model is what makes it invent a
# context that would explain the fragment.
CLAWBODY_VOICE_MIN_CHARS=2
# Drop bare "mhm" / "ok" / "嗯" / "啊" instead of answering them.
CLAWBODY_SUPPRESS_ACKS=true
# On unintelligible input, say a short "didn't catch that" instead of
# staying silent. Off by default: silence is less irritating than a robot
# apologising to the room every time a chair scrapes. Never fires for
# other-language or unaddressed speech -- replying to those would defeat
# the point of ignoring them.
CLAWBODY_APOLOGIZE_ON_REJECT=false

# Time grounding: the current local time is injected into the session
# instructions each turn (rate-limited to once a minute). Without it the
# model has no clock and guesses -- it wished the user goodnight at 1:28pm.
CLAWBODY_TIME_GROUNDING=true
CLAWBODY_TIMEZONE=America/Los_Angeles

# Voice-callable sleep/wake, using the SDK's goto_sleep()/wake_up(). Sleep
# puts the body in the sleep pose AND the mic into standby, where only the
# wake word gets through. Requires CLAWBODY_VOICE_GATE=true.
CLAWBODY_ENABLE_SLEEP_TOOLS=true

# Idempotency for conversation sync to the gateway: the same turn was
# observed being re-sent verbatim 13 minutes apart, which both wastes a
# backend run and writes phantom repetition into the agent's memory.
CLAWBODY_SYNC_DEDUPE=true
CLAWBODY_SYNC_DEDUPE_TTL_S=900
# How long the fetched agent context is reused before re-fetching. This
# used to fire on every Realtime reconnect -- eight full context-handoff
# requests in twenty minutes.
CLAWBODY_CONTEXT_TTL_S=3600
